---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
import {
  nightRates,
  childRate,
  touristTax,
  halfBoardMenus,
  packedLunch,
  groupRates,
  drinks,
  wines,
} from "../data/tarifs";

const drinkSections = [
  { title: "Boissons sans alcool", items: drinks.nonAlcoholic },
  { title: "Boissons chaudes", items: drinks.hot },
  { title: "Bières", items: drinks.beer },
  { title: "Apéritifs", items: drinks.aperitif },
  { title: "Digestifs", items: drinks.digestif },
];

const wineSections = [
  { title: "Vins blancs", items: wines.white },
  { title: "Vins rouges", items: wines.red },
  { title: "Vins rosés", items: wines.rose },
];
---
<BaseLayout
  title="Tarifs 2026 — Gîte La Tuffière, Vuillafans (Doubs)"
  description="Tarifs 2026 du gîte La Tuffière : nuit avec petit-déjeuner, table d'hôtes, tarifs groupes, cartes des boissons et des vins."
>
  <PageHero
    image="/images/facade-moto.jpg"
    title="Tarifs 2026"
    lead="Prix par personne. Réservation uniquement par téléphone."
  />

  <section class="section">
    <div class="container">
      <span class="eyebrow">Hébergement</span>
      <h2>Nuit avec petit-déjeuner</h2>
      <table class="price-table">
        <tbody>
          {nightRates.map((row) => (
            <tr><td>{row.label}</td><td class="price-cell">{row.price}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="tarifs-note">{childRate}</p>
      <p class="tarifs-note">{touristTax}</p>
      <p class="tarifs-note">
        Composition détaillée des chambres : voir la page <a href="/gite/">Gîte</a>.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Table d'hôtes</span>
      <h2>Demi-pension (hors boissons)</h2>
      <p class="tarifs-note">Table d'hôtes sans hébergement : +10%.</p>
      <table class="price-table">
        <tbody>
          {halfBoardMenus.map((row) => (
            <tr><td>{row.label}</td><td class="price-cell">{row.price}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="tarifs-note">{packedLunch}</p>
      <p style="margin-top:16px;"><a href="/table-dhotes/" class="btn btn-outline">Voir le détail des menus</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Groupes</span>
      <h2>Tarifs groupes — menu tradition (entrée, plat, dessert)</h2>
      <div class="group-rates">
        {groupRates.map((g) => (
          <div class="group-rate-card">
            <p class="group-rate-price">{g.price}</p>
            <p>{g.label}</p>
            <p class="tarifs-note">{g.note}</p>
          </div>
        ))}
      </div>
      <p class="tarifs-note">{touristTax}</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Boissons &amp; vins</span>
      <h2>Nos cartes</h2>
      <div class="drinks-grid">
        {drinkSections.map((section) => (
          <div>
            <h4>{section.title}</h4>
            <table class="price-table price-table-compact">
              <tbody>
                {section.items.map((row) => (
                  <tr><td>{row.label}</td><td class="price-cell">{row.price}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>

      <h3 style="margin-top:36px;">Les vins</h3>
      <div class="drinks-grid">
        {wineSections.map((section) => (
          <div>
            <h4>{section.title}</h4>
            <table class="price-table price-table-compact">
              <tbody>
                {section.items.map((row) => (
                  <tr><td>{row.label}</td><td class="price-cell">{row.price}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="practical-band">
    <div class="container">
      <h2>Une question sur nos tarifs ?</h2>
      <p>Pour les groupes, séminaires, anniversaires ou repas de famille, appelez-nous pour un devis sur mesure.</p>
      <div class="hero-actions">
        <a href={site.phoneHref} class="btn btn-primary">Appeler le {site.phone}</a>
        <a href="/gite/" class="btn btn-outline-light">Découvrir le gîte</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .price-table {
    width: 100%;
    max-width: 640px;
    border-collapse: collapse;
    margin: 20px 0;
  }
  .price-table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--color-border);
  }
  .price-cell {
    text-align: right;
    font-weight: 700;
    white-space: nowrap;
  }
  .price-table-compact td { padding: 5px 8px; font-size: 0.92rem; }
  .tarifs-note {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 6px 0;
  }
  .group-rates {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 20px 0;
  }
  @media (max-width: 860px) {
    .group-rates { grid-template-columns: 1fr; }
  }
  .group-rate-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
  }
  .group-rate-price {
    font-family: var(--font-title);
    font-size: 1.4rem;
    color: var(--color-rust);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .drinks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 40px;
  }
  @media (max-width: 700px) {
    .drinks-grid { grid-template-columns: 1fr; }
  }
  .drinks-grid h4 {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
    color: var(--color-green-dark);
    margin-bottom: 6px;
  }
</style>
