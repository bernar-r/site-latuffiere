---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
import {
  nightRates,
  childRate,
  touristTax,
  halfBoardMenus,
  packedLunch,
  groupRates,
  drinks,
  wines,
} from "../data/tarifs";

const drinkSections = [
  { title: "Boissons sans alcool", items: drinks.nonAlcoholic },
  { title: "Boissons chaudes", items: drinks.hot },
  { title: "Bières", items: drinks.beer },
  { title: "Apéritifs", items: drinks.aperitif },
  { title: "Digestifs", items: drinks.digestif },
];

const wineSections = [
  { title: "Vins blancs", items: wines.white },
  { title: "Vins rouges", items: wines.red },
  { title: "Vins rosés", items: wines.rose },
];
---
<BaseLayout
  title="Tarifs 2026 : Nuitée, Repas & Groupes | Gîte La Tuffière"
  description="Consultez les tarifs 2026 du gîte La Tuffière : nuit avec petit-déjeuner compris, table d'hôtes, tarifs de groupe, cartes des boissons et des vins."
>
  <PageHero
    image="/images/facade-moto.jpg"
    title="Tarifs 2026"
    lead="Prix par personne · Petit-déjeuner inclus · Réservation uniquement par téléphone"
  />

  <!-- HÉBERGEMENT & DEMI-PENSION EN 2 COLONNES -->
  <section class="section">
    <div class="container">
      <div style="text-align:center;max-width:760px;margin:0 auto 36px;">
        <span class="eyebrow">Formules individuelles &amp; familles</span>
        <h2>Des tarifs clairs et transparents</h2>
        <p>Toutes nos nuitées comprennent un petit-déjeuner copieux ainsi que l'accès aux sanitaires privatifs (douche et WC) dans chaque chambre.</p>
      </div>

      <div class="tarifs-grid-2">
        <!-- CARTE NUITÉES -->
        <div class="tarifs-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <span class="eyebrow" style="color:var(--color-rust-dark);">Hébergement</span>
            <span class="room-tag">Petit-déjeuner inclus</span>
          </div>
          <h3 style="margin-bottom:12px;">Nuitée + Petit-Déjeuner</h3>
          <p style="font-size:0.92rem;color:#5c4c3e;margin-bottom:20px;">
            Tarifs par personne pour une nuit avec petit-déjeuner. Draps et serviettes fournis.
          </p>

          <table class="price-table">
            <tbody>
              {nightRates.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  <td class="price-cell">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--color-border);font-size:0.88rem;color:#5a493b;display:flex;flex-direction:column;gap:6px;">
            <p style="margin:0;">👶 <strong>Enfants :</strong> {childRate}</p>
            <p style="margin:0;">ℹ️ <strong>Taxe :</strong> {touristTax}</p>
            <p style="margin:0;">🛏️ Composition des lits : voir la page <a href="/gite/">Le Gîte &amp; Chambres</a></p>
          </div>
        </div>

        <!-- CARTE DEMI-PENSION -->
        <div class="tarifs-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <span class="eyebrow" style="color:var(--color-green-dark);">Table d'Hôtes</span>
            <span class="room-tag">Fait maison</span>
          </div>
          <h3 style="margin-bottom:12px;">Demi-Pension &amp; Menus</h3>
          <p style="font-size:0.92rem;color:#5c4c3e;margin-bottom:20px;">
            Repas servis le soir au gîte (hors boissons). Table d'hôtes sans hébergement : +10%.
          </p>

          <table class="price-table">
            <tbody>
              {halfBoardMenus.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  <td class="price-cell">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--color-border);font-size:0.88rem;color:#5a493b;display:flex;flex-direction:column;gap:6px;">
            <p style="margin:0;">🎒 <strong>Randonneurs :</strong> {packedLunch}</p>
            <p style="margin:0;">🍷 Boissons et vins de notre sélection en supplément</p>
            <p style="margin:0;"><a href="/table-dhotes/" class="card-link">Consulter le détail de la table d'hôtes →</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULES GROUPES -->
  <section class="section section-alt">
    <div class="container">
      <div style="text-align:center;max-width:760px;margin:0 auto 32px;">
        <span class="eyebrow">Clubs, Familles &amp; Séminaires</span>
        <h2>Tarifs Groupes — Formule Demi-Pension</h2>
        <p>
          Formule complète comprenant l'hébergement, le petit-déjeuner et le dîner Menu Tradition (entrée, plat, dessert du terroir).
        </p>
      </div>

      <div class="group-rates">
        {groupRates.map((g) => (
          <div class="group-rate-card">
            <span class="room-tag" style="margin-bottom:12px;width:fit-content;align-self:center;">Formule Groupe</span>
            <p class="group-rate-price">{g.price}</p>
            <p style="font-weight:600;margin-bottom:6px;">{g.label}</p>
            <p class="tarifs-note" style="margin:0;color:#6b5747;">{g.note}</p>
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:24px;">
        <p class="tarifs-note">
          {touristTax} · Pour les séminaires avec salle de réunion ou événements particuliers, contactez-nous pour un devis personnalisé.
        </p>
      </div>
    </div>
  </section>

  <!-- CARTES DES BOISSONS ET DES VINS -->
  <section class="section">
    <div class="container">
      <div style="text-align:center;max-width:720px;margin:0 auto 36px;">
        <span class="eyebrow">À l'apéritif ou à table</span>
        <h2>Cartes des Boissons &amp; Vins du Terroir</h2>
        <p>Une sélection de vins du Jura, bières régionales, apéritifs comtois et boissons fraîches à apprécier sur la terrasse ombragée.</p>
      </div>

      <div class="drinks-grid">
        {drinkSections.map((section) => (
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:var(--radius);padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.02);">
            <h4>{section.title}</h4>
            <table class="price-table price-table-compact">
              <tbody>
                {section.items.map((row) => (
                  <tr>
                    <td>{row.label}</td>
                    <td class="price-cell">{row.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>

      <h3 style="margin:48px 0 20px;text-align:center;">Vins d'Alsace, Jura &amp; Région</h3>
      <div class="drinks-grid">
        {wineSections.map((section) => (
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:var(--radius);padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.02);">
            <h4>{section.title}</h4>
            <table class="price-table price-table-compact">
              <tbody>
                {section.items.map((row) => (
                  <tr>
                    <td>{row.label}</td>
                    <td class="price-cell">{row.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BANDEAU CTA -->
  <section class="practical-band">
    <div class="container">
      <h2>Une question sur nos formules ou un devis pour votre groupe ?</h2>
      <p style="max-width:640px;margin:0 auto 20px;">Appelez directement Bénédicte et Christian pour réserver votre séjour ou organiser vos repas.</p>
      <div class="hero-actions">
        <a href={site.phoneHref} class="btn btn-primary">📞 Appeler le {site.phone}</a>
        <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline-light" data-open-dispo>Voir les disponibilités</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .price-table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
  }
  .price-table td {
    padding: 9px 6px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.94rem;
  }
  .price-cell {
    text-align: right;
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-rust-dark);
  }
  .price-table-compact td {
    padding: 6px 4px;
    font-size: 0.9rem;
  }
  .tarifs-note {
    font-size: 0.9rem;
    opacity: 0.85;
    margin: 6px 0;
  }
  .group-rates {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 24px 0;
  }
  @media (max-width: 860px) {
    .group-rates { grid-template-columns: 1fr; }
  }
  .drinks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media (max-width: 760px) {
    .drinks-grid { grid-template-columns: 1fr; }
  }
  .drinks-grid h4 {
    font-family: var(--font-title);
    font-size: 1.15rem;
    color: var(--color-green-dark);
    margin: 0 0 12px;
    border-bottom: 2px solid var(--color-bg-alt);
    padding-bottom: 6px;
  }
</style>
