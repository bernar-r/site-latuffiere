---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
import { rooms, equipment } from "../data/rooms";
---
<BaseLayout
  title="Chambres & Gîte de Groupe 35 Personnes | La Tuffière (Doubs)"
  description="Hébergement de groupe Gîtes de France à Vuillafans : 10 chambres avec douche et WC privés, chambre PMR, parc arboré au bord de la Loue et garage moto fermé."
>
  <PageHero
    image="/images/gite-tables-exterieures.jpg"
    title="Un gîte plein de charme au cœur de la Franche-Comté"
    lead="Label Gîtes de France : hébergement de qualité dans le Doubs"
  />

  <!-- PRÉSENTATION & ÉQUIPEMENTS (COMME AVANT) -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Votre gîte dans le Doubs</span>
      <h2>Capacité d'accueil : 35 personnes</h2>
      <p>La Tuffière vous offre un hébergement de qualité, labellisé Gîtes de France, au bord de la Loue. Que ce soit pour un week-end, une semaine ou une seule nuit, le gîte s'adapte aux groupes comme aux familles.</p>
      <ul class="feature-list">
        {equipment.map((item) => <li>{item}</li>)}
      </ul>

      <!-- SHOWCASE DES 10 CHAMBRES -->
      <div style="margin-top:48px;">
        <span class="eyebrow">Les 10 chambres du gîte</span>
        <h3 style="margin-bottom:8px;font-size:1.6rem;">Chaque chambre dispose de sa salle d'eau et de WC privatifs</h3>
        <p style="color:#635243;margin-bottom:24px;">Nos 10 chambres portent les noms poétiques des oiseaux de la vallée de la Loue.</p>

        <!-- FILTRES DES CHAMBRES -->
        <div class="rooms-filter-container" id="room-filters">
          <button type="button" class="filter-chip active" data-filter="all">Toutes les chambres (10)</button>
          <button type="button" class="filter-chip" data-filter="2">2 personnes (2)</button>
          <button type="button" class="filter-chip" data-filter="3">3 personnes (3)</button>
          <button type="button" class="filter-chip" data-filter="4">4 personnes (4)</button>
          <button type="button" class="filter-chip" data-filter="6">6 personnes (1)</button>
          <button type="button" class="filter-chip" data-filter="pmr">Accessible PMR (1)</button>
        </div>

        <!-- GRILLE DES 10 CHAMBRES -->
        <div class="rooms-grid" id="rooms-grid">
          {rooms.map((room) => (
            <div
              class="room-card"
              data-capacity={room.capacity}
              data-pmr={room.pmr ? "true" : "false"}
            >
              <div class="room-card-top">
                <h3 class="room-name">{room.name}</h3>
                <span class={`room-tag ${room.pmr ? "pmr" : ""}`}>{room.tag}</span>
              </div>

              <p class="room-desc">{room.description}</p>

              <ul class="room-meta-list">
                <li>
                  <span class="room-badge-icon">🛏️</span>
                  <span><strong>Lits :</strong> {room.beds}</span>
                </li>
                <li>
                  <span class="room-badge-icon">📍</span>
                  <span><strong>Situation :</strong> {room.floor}</span>
                </li>
                <li>
                  <span class="room-badge-icon">🚿</span>
                  <span><strong>Sanitaires :</strong> Douche, lavabo et WC privatifs</span>
                </li>
              </ul>

              <div style="margin-top:auto;padding-top:12px;display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--color-border);">
                <span style="font-size:0.85rem;color:var(--color-green-dark);font-weight:600;">
                  {room.capacity} couchages
                </span>
                <a href="/tarifs/" class="card-link" style="font-size:0.85rem;">Voir les tarifs →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- UN ESPACE POUR TOUS -->
  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Pour tous</span>
        <h2>Un espace pour tous les voyageurs</h2>
        <p>Motards, randonneurs, pêcheurs, familles, couples ou groupes : La Tuffière est pensée pour accueillir un grand nombre de profils différents, pour une nuit comme pour un séjour complet.</p>
        <p>La location se fait à la chambre. Pour connaître la disponibilité adaptée à votre séjour, consultez le calendrier ci-dessous puis appelez-nous pour confirmer.</p>
        <div class="hero-actions" style="justify-content:flex-start;">
          <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline" data-open-dispo>Voir les disponibilités</a>
          <a href={site.phoneHref} class="btn btn-primary">Appeler le {site.phone}</a>
        </div>
      </div>
      <div>
        <img src="/images/gite-chambre-fauvette.jpg" alt="Chambre La Fauvette du gîte La Tuffière" loading="lazy">
      </div>
    </div>
  </section>

  <!-- MOSAÏQUE EXTÉRIEURS -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Nos espaces</span>
      <h2>Extérieurs et façade</h2>
      <div class="mosaic" style="grid-auto-rows:220px;">
        <a href="/galerie/"><img src="/images/gite-ext-33.jpg" alt="Jardin et terrasse couverte du gîte La Tuffière" loading="lazy"></a>
        <a href="/galerie/"><img src="/images/gite-tables-exterieures.jpg" alt="Terrasse couverte et jardin du gîte" loading="lazy"></a>
        <a href="/galerie/"><img src="/images/facade-moto.jpg" alt="Façade du gîte La Tuffière" loading="lazy"></a>
      </div>
      <p style="text-align:center;margin-top:24px;"><a href="/galerie/" class="btn btn-outline">Voir toute la galerie</a></p>
    </div>
  </section>

  <!-- BANDEAU CTA -->
  <section class="practical-band">
    <div class="container">
      <h2>On se voit quand ?</h2>
      <p>Consultez nos tarifs ou appelez-nous directement pour organiser votre séjour.</p>
      <div class="hero-actions">
        <a href="/tarifs/" class="btn btn-outline-light">Voir les tarifs</a>
        <a href={site.phoneHref} class="btn btn-primary">Appeler le {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Filtre interactif instantané des chambres
  const filterButtons = document.querySelectorAll("#room-filters .filter-chip");
  const roomCards = document.querySelectorAll("#rooms-grid .room-card");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.getAttribute("data-filter");

      roomCards.forEach((card) => {
        const capacity = card.getAttribute("data-capacity");
        const isPmr = card.getAttribute("data-pmr") === "true";

        let shouldShow = false;
        if (filter === "all") {
          shouldShow = true;
        } else if (filter === "pmr") {
          shouldShow = isPmr;
        } else if (filter === capacity) {
          shouldShow = true;
        }

        if (shouldShow) {
          (card as HTMLElement).style.display = "flex";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>

<style>
  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 24px;
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }
  .feature-list li {
    padding-left: 22px;
    position: relative;
  }
  .feature-list li::before {
    content: "•";
    color: var(--color-rust);
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .feature-list { grid-template-columns: 1fr; }
  }
</style>
