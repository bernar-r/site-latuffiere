---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
import { menus, flammekueche, allergenNote } from "../data/menus";
---
<BaseLayout
  title="Table d'hôtes — Gîte La Tuffière, Vuillafans (Doubs)"
  description="Table d'hôtes de La Tuffière : cuisine régionale franc-comtoise, produits locaux. Menu Tradition 25€, Menu Dégustation 41€, tartes flambées à volonté. Réservation par téléphone."
>
  <PageHero
    image="/images/table-salle-reception.jpg"
    title="Manger à La Tuffière : notre table d'hôtes"
    lead="Saveurs du terroir franc-comtois, produits locaux et ambiance conviviale"
  />

  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Gastronomie</span>
        <h2>Régalez-vous toute l'année à La Tuffière</h2>
        <p>Pour vous assurer qualité et saveurs, nous travaillons avec des producteurs locaux dans la mesure du possible. Le soir, vous dégusterez un repas régional autour de la table commune, avec des légumes de saison et des plats gourmands.</p>
        <p>La table d'hôtes, c'est aussi l'occasion d'échanger les impressions de la journée dans une ambiance conviviale.</p>
        <a href={site.phoneHref} class="btn btn-outline">Appeler pour réserver</a>
      </div>
      <div>
        <img src="/images/home-tables-exterieures.jpg" alt="Repas partagé sur la terrasse de La Tuffière" loading="lazy">
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Nos menus</span>
      <h2>Cartes 2026</h2>
      <p>Prix par personne. Menus proposés uniquement sur réservation — nous consulter pour les allergies et régimes particuliers.</p>

      <div class="menus-grid">
        {menus.map((menu) => (
          <article class="menu-card">
            <h3>{menu.name}</h3>
            <p class="menu-price">{menu.price}</p>
            <ul class="menu-conditions">
              {menu.conditions.map((c) => <li>{c}</li>)}
            </ul>
            {menu.sections.map((section) => (
              <div class="menu-section">
                <h4>{section.title}</h4>
                <ul>
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </div>

      <article class="menu-card menu-card-flamme">
        <h3>{flammekueche.name}</h3>
        <p>{flammekueche.description}</p>
      </article>

      <p class="allergen-note">{allergenNote}</p>
    </div>
  </section>

  <section class="section text-center">
    <div class="container">
      <p class="hero-tagline">« Le partage et l'échange sont primordiaux à La Tuffière »</p>
      <p><strong>— Bénédicte &amp; Christian</strong></p>
    </div>
  </section>

  <section class="practical-band">
    <div class="container">
      <h2>Envie de réserver votre table ?</h2>
      <p>La table d'hôtes se réserve à l'avance, en même temps que votre séjour.</p>
      <div class="hero-actions">
        <a href={site.phoneHref} class="btn btn-primary">Appeler le {site.phone}</a>
        <a href="/tarifs/" class="btn btn-outline-light">Voir les tarifs d'hébergement</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .menus-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 28px;
  }
  @media (max-width: 860px) {
    .menus-grid { grid-template-columns: 1fr; }
  }
  .menu-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .menu-card h3 {
    margin-bottom: 4px;
  }
  .menu-price {
    font-weight: 700;
    color: var(--color-rust);
    margin-bottom: 10px;
  }
  .menu-conditions {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    font-size: 0.88rem;
    color: var(--color-text);
    opacity: 0.85;
  }
  .menu-conditions li::before { content: "— "; }
  .menu-section { margin-top: 14px; }
  .menu-section h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-green-dark);
    margin-bottom: 6px;
  }
  .menu-section ul {
    margin: 0;
    padding-left: 20px;
  }
  .menu-section li { margin-bottom: 4px; }
  .menu-card-flamme {
    margin-top: 28px;
    text-align: center;
    border-color: var(--color-rust);
  }
  .allergen-note {
    margin-top: 20px;
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
