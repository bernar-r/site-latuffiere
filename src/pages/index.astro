---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, labels } from "../data/site";
---
<BaseLayout
  title="Gîte La Tuffière — Gîte 35 Personnes & Table d'Hôtes (Doubs)"
  description="Gîte de groupe 35 personnes à Vuillafans dans le Doubs : 10 chambres avec sanitaires privés, table d'hôtes du terroir et grand parc au bord de la Loue."
>
  <!-- HERO : une seule photo forte, pas de diaporama -->
  <section class="hero" style="background-image:url('/images/hero-1-facade.jpg')">
    <div class="hero-content">
      <span class="hero-kicker">Vuillafans · Vallée de la Loue · Doubs</span>
      <h1>Gîte La Tuffière</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-meta">{site.capacity} — table d'hôtes — réservation uniquement par téléphone</p>
      <div class="hero-actions">
        <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-primary" data-open-dispo>Voir les disponibilités</a>
        <a href={site.phoneHref} class="btn btn-outline-light">Appeler le {site.phone}</a>
      </div>
    </div>
  </section>

  <!-- BANDEAU LABELS -->
  <section class="labels-band">
    <div class="container">
      {labels.map((label) => (
        <a class="label-item" href={label.href} target="_blank" rel="noopener">
          <img src={label.logo} alt={label.title} loading="lazy">
          <span>
            <strong>{label.title}</strong>
            <span>{label.description}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- À PROPOS -->
  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Bénédicte &amp; Christian vous accueillent</span>
        <h2>Une maison familiale au bord de la Loue</h2>
        <p>À l'orée du village de Vuillafans, La Tuffière est une grande bâtisse entourée d'un parc arboré, à 200 mètres de la rivière et sur les <a href="/activites/">sentiers de randonnée de la vallée de la Loue</a>. Vous y trouverez le calme d'une terrasse ombragée, un terrain de boules et un terrain de volley.</p>
        <p><strong>Capacité d'accueil : 35 personnes</strong>, réparties en <a href="/gite/">10 chambres tout confort</a> (de 2, 4 ou 6 lits), toutes équipées de salle d'eau et de WC privatifs.</p>
        <a href="/gite/" class="btn btn-outline">Découvrir le gîte</a>
      </div>
      <div>
        <img src="/images/home-tables-exterieures.jpg" alt="Tables extérieures ombragées du gîte La Tuffière" loading="lazy">
      </div>
    </div>
  </section>

  <!-- MOSAÏQUE GALERIE -->
  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">En images</span>
      <h2>La vallée, le gîte, la table</h2>
      <div class="mosaic">
        <a href="/galerie/" class="wide"><img src="/images/home-gallery-1.jpg" alt="Façade authentique et jardin du gîte La Tuffière à Vuillafans" loading="lazy"></a>
        <a href="/galerie/" class="tall"><img src="/images/home-gallery-2.jpg" alt="Cascade de tuf et rivière dans la Vallée de la Loue" loading="lazy"></a>
        <a href="/galerie/"><img src="/images/home-gallery-3.jpg" alt="Pâturages franc-comtois et vaches montbéliardes dans le Doubs" loading="lazy"></a>
        <a href="/galerie/"><img src="/images/home-gallery-4.jpg" alt="Sentier de randonnée pédestre et falaises de la Vallée de la Loue" loading="lazy"></a>
        <a href="/galerie/" class="wide"><img src="/images/home-gallery-5.jpg" alt="Vignobles et collines panoramiques autour de Vuillafans" loading="lazy"></a>
      </div>
    </div>
  </section>

  <!-- TABLE D'HÔTES -->
  <section class="section">
    <div class="container two-col">
      <div>
        <img src="/images/home-instagram.jpg" alt="Repas convivial à la table d'hôtes du gîte La Tuffière" loading="lazy">
      </div>
      <div>
        <span class="eyebrow">Table d'hôtes</span>
        <h2>Partage et cuisine régionale</h2>
        <p>Le soir, profitez de la terrasse et d'une cuisine familiale du terroir. Entre <a href="/table-dhotes/">menus traditionnels et tartes flambées à volonté</a>, partagez des repas généreux. Retrouvez l'ensemble de nos formules dans notre <a href="/tarifs/">grille des tarifs</a>.</p>
        <a href="/table-dhotes/" class="btn btn-outline">Découvrir la table d'hôtes</a>
      </div>
    </div>
  </section>

  <!-- INFOS PRATIQUES -->
  <section class="practical-band">
    <div class="container">
      <h2>Réserver votre séjour</h2>
      <p>La location se fait à la chambre ou en groupe. Consultez nos <a href="/tarifs/">tarifs détaillés</a> et les disponibilités en ligne, puis <a href="/contact/">contactez-nous directement</a> pour valider votre séjour.</p>
      <div class="hero-actions">
        <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline-light" data-open-dispo>Voir les disponibilités</a>
        <a href={site.phoneHref} class="btn btn-primary">Appeler le {site.phone}</a>
        <a href="/tarifs/" class="btn btn-outline-light">Voir les tarifs</a>
      </div>
    </div>
  </section>

  <!-- AVIS (widget tiers réel, à confirmer) -->
  <section class="section">
    <div class="container">
      <div class="reviews-header">
        <span class="eyebrow">Témoignages</span>
        <h2>L'avis de nos hôtes</h2>
      </div>
      <div class="elfsight-app-f95532ad-1d47-4bc0-b109-936710c6a781" data-elfsight-app-lazy></div>
      <script src="https://static.elfsight.com/platform/platform.js" async></script>
      <p style="text-align:center;">
        <a href={site.googleMaps} target="_blank" rel="noopener">Voir tous les avis sur Google →</a>
      </p>
    </div>
  </section>
</BaseLayout>

