---
import { site, nav } from "../data/site";

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo"><img src="/images/logo.png" alt="Gîte La Tuffière" width="104" height="52"></a>
    <nav class="main-nav" id="main-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class={path === item.href ? "is-active" : ""}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline" data-open-dispo>
        <span class="label-full">Voir les disponibilités</span>
        <span class="label-short" aria-hidden="true">Dispos</span>
      </a>
      <a href={site.phoneHref} class="btn btn-primary">
        <span class="label-full">Appeler {site.phone}</span>
        <span class="label-short" aria-hidden="true">Appeler</span>
      </a>
    </div>
    <button class="nav-toggle" id="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav">☰</button>
  </div>
</header>

<div class="mobile-cta-bar">
  <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline" data-open-dispo>Disponibilités</a>
  <a href={site.phoneHref} class="btn btn-primary">Appeler</a>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<style>
  .label-short { display: none; }
</style>
