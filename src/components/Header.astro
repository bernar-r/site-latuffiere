---
import { site, nav } from "../data/site";

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo"><img src="/images/logo.png" alt="Gîte La Tuffière" width="104" height="52"></a>

    <!-- Nav desktop : toujours dans le DOM, jamais dependante d'un <details> ferme (fiabilite cross-navigateur). -->
    <nav class="main-nav main-nav-desktop">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class={path === item.href ? "is-active" : ""}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Nav mobile : <details> gere nativement l'ouverture/fermeture, sans JavaScript. -->
    <details class="nav-details" id="nav-details">
      <summary class="nav-toggle" aria-label="Ouvrir le menu">☰</summary>
      <nav class="main-nav main-nav-mobile" id="main-nav">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} class={path === item.href ? "is-active" : ""}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>

    <div class="header-actions">
      <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline" data-open-dispo>
        <span class="label-full">Voir les disponibilités</span>
        <span class="label-short" aria-hidden="true">Dispos</span>
      </a>
      <a href={site.phoneHref} class="btn btn-primary">
        <span class="label-full">Appeler {site.phone}</span>
        <span class="label-short" aria-hidden="true">Appeler</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-cta-bar">
  <a href={site.dispoIframeUrl} target="_blank" rel="noopener" class="btn btn-outline" data-open-dispo>Disponibilités</a>
  <a href={site.phoneHref} class="btn btn-primary">Appeler</a>
</div>

<script>
  // <details> gere nativement l'ouverture/fermeture (fonctionne sans JS) ; on ferme juste au clic sur un lien.
  const details = document.getElementById("nav-details");
  if (details) {
    details.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        details.removeAttribute("open");
      });
    });
  }
</script>

<style>
  .label-short { display: none; }
  @media (max-width: 1220px) {
    .label-full { display: none; }
    .label-short { display: inline; }
  }
</style>
